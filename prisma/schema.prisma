// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/lib/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// El diseño se recorre en tres etapas: `Diseno` es el trabajo en curso,
/// `AvanceDiseno` el avance que se le presenta al cliente y `DisenoFinalizado`
/// el diseño cerrado, que es cuando se persigue el cobro de aprobación.
/// El desarrollo tiene el mismo cierre: `Desarrollo` es el trabajo en curso y
/// `DesarrolloFinalizado` es cuando ya se subió a producción, se hizo la
/// capacitación y se contrató el hosting — ahí es cuando se persigue el cobro
/// de entrega, y recién con eso cobrado pasa a `ProyectoFinalizado`.
/// El orden del enum es el del pipeline; `ORDEN_ETAPAS` lo repite en código.
enum EstadoProyecto {
  Registro
  Brief
  Taxonomia
  Diseno                @map("Diseño")
  AvanceDiseno          @map("Avance de Diseño")
  DisenoFinalizado      @map("Diseño Finalizado")
  Desarrollo
  DesarrolloFinalizado  @map("Desarrollo Finalizado")
  ProyectoFinalizado    @map("Proyecto Finalizado")
  Archivado
}

/// Los tres momentos de cobro del flujo. Son fijos; lo variable es el
/// porcentaje de cada uno, que administración carga a mano por proyecto.
enum HitoCobro {
  AbonoInicial
  AprobacionDiseno
  Entrega
}

/// Decide dos bifurcaciones del flujo: la web informativa saltea la taxonomía,
/// y el catálogo y la carga de productos son solo de e-commerce.
/// Los `@map` respetan los valores que ya había en la columna de texto.
/// `Sistema` (apps/sistemas a medida) se comporta igual que `Informativa` en
/// las dos bifurcaciones — no requiere taxonomía ni carga de catálogo — hasta
/// que el equipo defina una regla propia. Se asigna a mano, igual que los
/// otros dos.
enum TipoProyecto {
  Informativa
  Ecommerce   @map("E-commerce")
  Sistema
}

/// Los cinco recordatorios del diagrama. Todos desembocan en archivado a los
/// 3 meses (el conector «AR»).
enum TipoRecordatorio {
  MaterialMarca
  Catalogo
  CobroAprobacionDiseno
  CobroEntrega
  Hosting
}

enum Tecnologia {
  Shopify
  WordPress
  Personalizado @map("personalizado")
}

enum Grupo {
  A
  B
  C
}

/// Qué disparó cada aviso interno. Es lo que el front usa para elegir ícono
/// y a dónde llevar al usuario al hacer clic.
enum TipoNotificacion {
  ProyectoAsignado
  EtapaFinalizada
  ReunionProgramada
  ReunionProxima
  NotaRecibida
  NotaRespondida
}

/// En qué va un ticket del equipo. `Pendiente` es el estado de entrada;
/// administración lo mueve a mano.
enum EstadoNota {
  Pendiente
  EnCurso
  Resuelta
}

/// De qué trata el ticket. Sirve para ordenar la bandeja: los bloqueos van
/// primero. Las notas anteriores al sistema de tickets quedan en `Otro`.
enum CategoriaNota {
  Consulta
  Bloqueo
  Material
  Cambio
  Otro
}

model Rol {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]

  @@map("rols")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  user     String  @unique
  password String
  active   Boolean @default(true)
  roleId   Int     @map("role_id")

  /// Correo corporativo, para invitar a la persona al evento de Google
  /// Calendar cuando se agenda una reunión. Opcional: los usuarios que ya
  /// existían no lo tienen, y sin él simplemente no se lo invita.
  email String?


  rol       Rol               @relation(fields: [roleId], references: [id])
  proyectos UsuarioProyecto[]

  proyectosDisenados     Proyecto[]             @relation("ProyectosDisenados")
  proyectosDesarrollados Proyecto[]             @relation("ProyectosDesarrollados")
  cambiosDeEtapa         HistorialEtapa[]
  recordatorios          RecordatorioProyecto[]
  cotizaciones           CotizacionAdicional[]
  notificaciones         Notificacion[]
  reunionesCreadas       Reunion[]              @relation("ReunionesCreadas")
  reuniones              ReunionUsuario[]
  notasEnviadas          NotaAdmin[]
  respuestasNota         RespuestaNota[]

  @@index([roleId])
  @@map("users")
}

model Seguimiento {
  id   Int    @id @default(autoincrement())
  name String

  /// Código estable del seguimiento, para automatizaciones que no pueden
  /// depender de `name` (editable) ni del id (tiene huecos por borrados).
  /// La columna ya existía en la base; todavía no hay código que la use.
  codigo String? @unique

  proyectos Proyecto[]

  @@map("seguimientos")
}

model Proyecto {
  id               Int            @id @default(autoincrement())
  name             String
  estadoPago       String         @default("50%") @map("estado_pago")
  estadoProyecto   EstadoProyecto @default(Brief) @map("estado_proyecto")
  descripcion      String         @db.Text
  tecnologia       Tecnologia?
  tipoProyecto     TipoProyecto?  @map("tipo_proyecto")
  grupo            Grupo
  seguimientoId    Int            @map("seguimiento_id")
  comentario       String         @db.Text
  diasSinResponder String?        @map("dias_sin_responder")

  /// Compromiso de entrega **final**, el del proyecto entero. Es la columna
  /// que ya existía: los valores cargados hasta ahora siguen significando lo
  /// mismo. La del diseño va aparte porque antes las dos se pisaban.
  fechaEntrega DateTime? @map("fecha_entrega")

  /// Compromiso de entrega del **diseño**. La ve y la carga el diseñador en su
  /// tablero; el desarrollador trabaja con `fechaEntrega`.
  fechaEntregaDiseno DateTime? @map("fecha_entrega_diseno")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  /// Bloqueos del cliente, separados a propósito: el material de marca frena el
  /// diseño, mientras que el catálogo solo frena la carga de productos.
  materialMarcaRecibido Boolean @default(false) @map("material_marca_recibido")
  catalogoRecibido      Boolean @default(false) @map("catalogo_recibido")

  /// Rondas de cambios de diseño ya consumidas. El plan incluye 1 presentación
  /// de avance + 2 rondas de cambios + la entrega final.
  rondasCambiosUsadas Int @default(0) @map("rondas_cambios_usadas")

  /// Contratación del hosting (nodo B11). Va al final del flujo a propósito:
  /// después del cobro de entrega y antes de subir a producción, para que el
  /// cliente aproveche al máximo el tiempo de su servicio. Bloquea producción
  /// y manda el proyecto al Grupo C mientras falte.
  hostingContratado Boolean @default(false) @map("hosting_contratado")

  /// Hitos de la Fase 1 que el diagrama no modela como estado pero sí como
  /// paso con responsable. `factibilidad` no bloquea (nodo F1): se registra
  /// solo para poder auditar que el desarrollador revisó antes de presentar.
  factibilidadRevisadaAt DateTime? @map("factibilidad_revisada_at")
  disenoAprobadoAt       DateTime? @map("diseno_aprobado_at")

  /// Tramo final (nodos B4 a B14). Son sub-pasos dentro de `Desarrollo`: el
  /// diagrama no les asigna `estadoProyecto`, solo el nodo final B15 lo tiene.
  /// Por eso van como marcas de tiempo y no como valores nuevos del enum.
  productosCargados  Boolean   @default(false) @map("productos_cargados")
  presentadoAt       DateTime? @map("presentado_at")
  subidoProduccionAt DateTime? @map("subido_produccion_at")
  capacitacionAt     DateTime? @map("capacitacion_at")

  /// Momento del último cambio de etapa: de aquí sale el contador de los 3
  /// meses para archivar, que se reinicia en cada cambio de estado.
  fechaUltimoCambioEstado DateTime? @map("fecha_ultimo_cambio_estado")
  archivadoAt             DateTime? @map("archivado_at")

  /// Carpeta de Drive con todo el material del proyecto (brief, logos, fotos,
  /// catálogo…). Es un solo enlace: adentro va la estructura que use el
  /// equipo. Se carga en el alta para que esté listo desde el día uno.
  enlaceMateriales String? @map("enlace_materiales")

  /// Asignados en el registro del proyecto. No rotan, pero se pueden reasignar
  /// y el cambio queda en el historial.
  disenadorId     Int? @map("disenador_id")
  desarrolladorId Int? @map("desarrollador_id")

  seguimiento   Seguimiento            @relation(fields: [seguimientoId], references: [id])
  usuarios      UsuarioProyecto[]
  disenador     User?                  @relation("ProyectosDisenados", fields: [disenadorId], references: [id])
  desarrollador User?                  @relation("ProyectosDesarrollados", fields: [desarrolladorId], references: [id])
  cobros         Cobro[]
  historial      HistorialEtapa[]
  recordatorios  RecordatorioProyecto[]
  cotizaciones   CotizacionAdicional[]
  notificaciones Notificacion[]
  reuniones      Reunion[]
  notas          NotaAdmin[]

  @@index([seguimientoId])
  @@index([disenadorId])
  @@index([desarrolladorId])
  @@map("proyectos")
}

/// Un registro por hito de cobro. Los porcentajes los carga administración a
/// mano; el sistema no maneja montos en dinero, solo el % y si está cobrado.
model Cobro {
  id         Int       @id @default(autoincrement())
  proyectoId Int       @map("proyecto_id")
  hito       HitoCobro
  porcentaje Int
  cobrado    Boolean   @default(false)
  fechaCobro DateTime? @map("fecha_cobro")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@unique([proyectoId, hito])
  @@index([proyectoId])
  @@map("cobros")
}

/// Trazabilidad: una fila por cambio de etapa o de grupo, con quién lo movió y
/// cuándo. Es la base de los KPIs (cuánto dura cada etapa, cuántos días estuvo
/// el proyecto esperando al cliente).
model HistorialEtapa {
  id             Int             @id @default(autoincrement())
  proyectoId     Int             @map("proyecto_id")
  estadoAnterior EstadoProyecto? @map("estado_anterior")
  estadoNuevo    EstadoProyecto  @map("estado_nuevo")
  grupoAnterior  Grupo?          @map("grupo_anterior")
  grupoNuevo     Grupo           @map("grupo_nuevo")
  motivo         String?         @db.Text
  usuarioId      Int?            @map("usuario_id")
  createdAt      DateTime        @default(now()) @map("created_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  usuario  User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([proyectoId])
  @@index([usuarioId])
  @@map("historial_etapas")
}

/// Los cinco recordatorios del diagrama, ligados al proyecto que los generó.
/// Distinta de `recordatorios`, que es una lista de notas sueltas sin relación.
///
/// Un recordatorio abierto es lo que define «el proyecto está esperando al
/// cliente»: de ahí salen los días sin responder y el contador de archivado.
/// Solo puede haber uno abierto por tipo y proyecto a la vez.
model RecordatorioProyecto {
  id         Int              @id @default(autoincrement())
  proyectoId Int              @map("proyecto_id")
  tipo       TipoRecordatorio
  /// Nulo mientras el bloqueo siga vigente; se completa cuando el cliente responde.
  resueltoAt DateTime?        @map("resuelto_at")
  usuarioId  Int?             @map("usuario_id")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  usuario  User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([proyectoId])
  @@index([usuarioId])
  @@index([resueltoAt])
  @@map("recordatorios_proyecto")
}

/// Cotizaciones fuera del precio cerrado: rondas de diseño agotadas (A10c) y
/// observaciones fuera del alcance aprobado (B8). Van aparte del plan de
/// cobros, que son siempre los tres hitos fijos.
model CotizacionAdicional {
  id         Int      @id @default(autoincrement())
  proyectoId Int      @map("proyecto_id")
  motivo     String   @db.Text
  /// El sistema no maneja montos: solo si la cotización se aprobó y se cobró.
  aprobada   Boolean  @default(false)
  cobrada    Boolean  @default(false)
  usuarioId  Int?     @map("usuario_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  usuario  User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([proyectoId])
  @@index([usuarioId])
  @@map("cotizaciones_adicionales")
}

model UsuarioProyecto {
  usuarioId  Int      @map("usuario_id")
  proyectoId Int      @map("proyecto_id")
  createdAt  DateTime @default(now()) @map("created_at")

  usuario  User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, proyectoId])
  @@index([usuarioId])
  @@index([proyectoId])
  @@map("usuarios_proyectos")
}

model Recordatorio {
  id          Int     @id @default(autoincrement())
  descripcion String  @db.Text
  estado      Boolean @default(true)

  @@map("recordatorios")
}

/// Aviso interno para un usuario puntual: «se te asignó un proyecto», «este
/// diseño finalizó, hay que cobrar», «te invitaron a una reunión», «llegó una
/// nota». Es lo que alimenta la campanita del front. Distinto del webhook de
/// Discord, que es un canal de salida sin destinatario ni estado.
///
/// El front consulta las suyas cada tanto (polling); no hay push. `leidaAt`
/// nulo = todavía no la vio.
model Notificacion {
  id         Int              @id @default(autoincrement())
  usuarioId  Int              @map("usuario_id")
  tipo       TipoNotificacion
  titulo     String
  mensaje    String           @db.Text
  proyectoId Int?             @map("proyecto_id")
  leidaAt    DateTime?        @map("leida_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  usuario  User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proyecto Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  @@index([usuarioId, leidaAt])
  @@index([proyectoId])
  @@map("notificaciones")
}

/// Reunión que administración agenda con parte del equipo. El link de Meet es
/// obligatorio: la reunión existe para que el diseñador o desarrollador lo
/// tenga a mano en su vista. Puede o no estar ligada a un proyecto.
model Reunion {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?  @db.Text
  fecha       DateTime
  linkMeet    String   @map("link_meet")
  /// Cuándo se mandó el aviso de «empieza en unos minutos». Queda marcado
  /// para que la tarea programada no lo repita en cada pasada.
  avisoPrevioAt DateTime? @map("aviso_previo_at")
  proyectoId  Int?     @map("proyecto_id")
  creadorId   Int?     @map("creador_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  proyecto      Proyecto?        @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  creador       User?            @relation("ReunionesCreadas", fields: [creadorId], references: [id], onDelete: SetNull)
  participantes ReunionUsuario[]

  @@index([fecha])
  @@index([proyectoId])
  @@map("reuniones")
}

model ReunionUsuario {
  reunionId Int @map("reunion_id")
  usuarioId Int @map("usuario_id")

  reunion Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  usuario User    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([reunionId, usuarioId])
  @@index([usuarioId])
  @@map("reuniones_usuarios")
}

/// Nota que un diseñador o desarrollador le deja a administración sobre un
/// proyecto. Solo administración la lee; el autor ve las que mandó. Es
/// distinta de `Recordatorio` (notas sueltas de administración para sí misma)
/// y de `RecordatorioProyecto` (los cinco bloqueos del flujo).
model NotaAdmin {
  id         Int       @id @default(autoincrement())
  proyectoId Int       @map("proyecto_id")
  autorId    Int?      @map("autor_id")
  contenido  String    @db.Text
  leidaAt    DateTime? @map("leida_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  /// En qué va el ticket. `leidaAt` se conserva y se sella la primera vez que
  /// administración lo saca de `Pendiente`: sigue siendo «ya lo vieron».
  estado    EstadoNota    @default(Pendiente)
  categoria CategoriaNota @default(Otro)

  /// Última vez que alguien escribió en el hilo. Ordena la bandeja por
  /// actividad sin tener que mirar las respuestas.
  ultimaRespuestaAt DateTime? @map("ultima_respuesta_at")

  proyecto   Proyecto        @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  autor      User?           @relation(fields: [autorId], references: [id], onDelete: SetNull)
  respuestas RespuestaNota[]

  @@index([proyectoId])
  @@index([autorId])
  @@index([leidaAt])
  @@index([estado])
  @@map("notas_admin")
}

/// Cada mensaje del hilo de un ticket, de cualquiera de los dos lados: el
/// autor que aclara y administración que responde. El texto original de la
/// nota no vive acá, sigue en `NotaAdmin.contenido`.
model RespuestaNota {
  id        Int      @id @default(autoincrement())
  notaId    Int      @map("nota_id")
  autorId   Int?     @map("autor_id")
  contenido String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  nota  NotaAdmin @relation(fields: [notaId], references: [id], onDelete: Cascade)
  autor User?     @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([notaId])
  @@index([autorId])
  @@map("respuestas_nota")
}
