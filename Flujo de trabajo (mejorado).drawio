        <mxCell id="A9" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#463A14;strokeColor=#D6B656;fontColor=#F5E7BE;fontSize=13;" value="¿Aprobó el diseño?" vertex="1">
