        <mxCell id="A4a" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=#5B9BD5;fontColor=#E8F0FA;fontSize=14;" value="Web informativa&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #93A7C0;&quot;&gt;WordPress / Personalizado&lt;/span&gt;" vertex="1">
