<mxfile host="Electron">
  <diagram name="Flujo de trabajo" id="flujo-websy-v4">
    <mxGraphModel dx="1088" dy="649" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="2620" background="#12161C" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="faseA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1F27;strokeColor=#39424E;fontColor=#7D8FA6;dashed=1;dashPattern=8 8;verticalAlign=top;fontSize=18;fontStyle=1;spacingTop=10;arcSize=3;" value="FASE 1 · Registro, Brief, Información y Diseño" vertex="1">
          <mxGeometry height="1500" width="760" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="faseB" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1F27;strokeColor=#39424E;fontColor=#7D8FA6;dashed=1;dashPattern=8 8;verticalAlign=top;fontSize=18;fontStyle=1;spacingTop=10;arcSize=3;" value="FASE 2 · Desarrollo, Cobros y Entrega" vertex="1">
          <mxGeometry height="1690" width="880" x="830" y="60" as="geometry" />
        </mxCell>
        <mxCell id="notaTraza" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#2A3550;strokeColor=#5B9BD5;fontColor=#DCE6F5;size=16;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Trazabilidad de etapas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cada vez que el proyecto cambia de etapa o se traba se registra &lt;b&gt;fecha, hora y quién lo movió&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Con la sola fecha de terminado se sabe cuántas webs salen al mes y nada más. Con la marca en cada paso se mide cuánto dura cada etapa y cuántos días estuvo el proyecto esperando al cliente.&lt;br&gt;&lt;br&gt;El historial también guarda los &lt;b&gt;cambios de diseñador o desarrollador&lt;/b&gt;." vertex="1">
          <mxGeometry height="255" width="215" x="65" y="105" as="geometry" />
        </mxCell>
        <mxCell id="notaCobros" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#3B3316;strokeColor=#D6B656;fontColor=#F2E7C6;size=16;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Plan de cobros del proyecto&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lo fijo son los &lt;b&gt;tres momentos de cobro&lt;/b&gt;, no los montos:&lt;br&gt;1. &lt;b&gt;Abono inicial&lt;/b&gt; — antes de arrancar el proyecto.&lt;br&gt;2. &lt;b&gt;Aprobación de diseño&lt;/b&gt; — al aprobar el diseño, antes de pasar a desarrollo.&lt;br&gt;3. &lt;b&gt;Entrega&lt;/b&gt; — al terminar el desarrollo, antes de subir a producción.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reglas de negocio:&lt;/b&gt;&lt;br&gt;• Los porcentajes deben sumar &lt;b&gt;exactamente 100&lt;/b&gt;. Si no, quedan proyectos que nunca terminan de estar cobrados.&lt;br&gt;• El abono inicial &lt;b&gt;nunca baja del 30%&lt;/b&gt;. Es el piso: por debajo requiere aprobación de la jefatura del área, no es campo libre.&lt;br&gt;&lt;br&gt;Lo típico es 50 / 30 / 20, pero hay proyectos que arrancan con 40% o 30% y el resto se reparte distinto: por eso el diagrama no lleva porcentajes.&lt;br&gt;&lt;br&gt;Los porcentajes los carga &lt;b&gt;administración a mano&lt;/b&gt; en cada proyecto." vertex="1">
          <mxGeometry height="370" width="240" x="550" y="105" as="geometry" />
        </mxCell>
        <mxCell id="A1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1D3A24;strokeColor=#7BC47F;fontColor=#DFF3E1;fontSize=14;fontStyle=1;" value="Inicio&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Nuevo proyecto vendido&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="180" x="330" y="100" as="geometry" />
        </mxCell>
        <mxCell id="A0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=#5B9BD5;fontColor=#E8F0FA;fontSize=14;" value="Registro del proyecto&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;se asigna diseñador y desarrollador (no rotan; se pueden reasignar y queda en el historial)&lt;br&gt;se define el plan de cobros y se registra el abono inicial&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #93A7C0;&quot;&gt;estadoProyecto: Registro · carga manual&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="250" x="295" y="180" as="geometry" />
        </mxCell>
        <mxCell id="A2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=#5B9BD5;fontColor=#E8F0FA;fontSize=14;" value="Brief inicial con el cliente&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #93A7C0;&quot;&gt;estadoProyecto: Brief · responsable: administración&lt;/span&gt;" vertex="1">
          <mxGeometry height="64" width="230" x="305" y="325" as="geometry" />
        </mxCell>
