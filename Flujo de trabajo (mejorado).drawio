        <mxCell id="F1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=#5B9BD5;fontColor=#E8F0FA;fontSize=13;" value="Revisión de factibilidad&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;el desarrollador asignado revisa el diseño antes de presentarlo al cliente&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="230" x="305" y="1100" as="geometry" />
