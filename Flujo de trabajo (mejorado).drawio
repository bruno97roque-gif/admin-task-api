        <mxCell id="notaFact" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#93A7C0;" value="&lt;b&gt;No bloquea:&lt;/b&gt; no hace falta la confirmación del desarrollador para presentar. La única aprobación que frena el flujo es la del cliente." vertex="1">
          <mxGeometry height="60" width="190" x="560" y="1105" as="geometry" />
